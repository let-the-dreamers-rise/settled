{
  "name": "settled",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "build:contracts": "bash scripts/build-contracts.sh",
    "test": "pnpm -r --filter ./packages/** test",
    "test:contract": "cargo test -p settled",
    "test:sandbox-pay": "pnpm --filter @settled/e2e-sandbox run pay",
    "e2e:sandbox": "pnpm --filter @settled/e2e-sandbox run e2e",
    "e2e": "pnpm --filter @settled/web run e2e",
    "cli": "tsx packages/cli/src/main.ts",
    "mock-1click": "tsx packages/mock-1click/src/main.ts",
    "probe:quote": "tsx scripts/probe-quote.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "fixtures:check": "node scripts/fixtures-check.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4",
    "@types/node": "22.16.5"
  }
}
